# دادبان (Dadban) — متغیرهای محیطی
# هیچ کلید واقعی‌ای در این فایل یا در کد ذخیره نمی‌شود.

# ─── دیتابیس (PostgreSQL) ──────────────────────────────────────────────
# خالی بگذارید تا در حالت degraded (بدون DB) اجرا شود
# برای Vercel: Neon/Supabase/Railway — مثال: postgresql://user:pass@host/db
DATABASE_URL=

# ─── احراز هویت کاربران (حداقل ۳۲ کاراکتر تصادفی) ─────────────────────
AUTH_SECRET=

# ─── مدیریت ادمین ───────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECRET=

# ─── هوش مصنوعی ────────────────────────────────────────────────────────
# کلید Z.ai (GLM) برای استقرار تولید (Vercel):
# https://api.z.ai/api/paas/v4 با مدل پیش‌فرض glm-4.6
ZAI_API_KEY=
# اگر می‌خواهید تأمین‌کننده/مدل دیگری بگذارید (OpenAI-سازگار):
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.6

# ─── دامنه ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dadban.ir

# ─── سئو و تحلیل (اختیاری) ─────────────────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BING_VERIFICATION=
