# sharifmand environment
# PostgreSQL connection — خالی بگذارید تا در حالت degraded (بدون DB) اجرا شود
# برای فعال‌سازی: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# احراز هویت کاربران (حداقل ۳۲ کاراکتر)
AUTH_SECRET=sharifmand-dev-secret-change-in-production-32chars

# مدیریت ادمین (اختیاری)
ADMIN_EMAIL=admin@sharifmand.local
ADMIN_PASSWORD=changeme-please-123
ADMIN_SECRET=sharifmand-admin-secret-change-me-32ch

# دستیار هوش مصنوعی (اختیاری — بدون کلید از حالت keyless استفاده می‌کند)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

NEXT_PUBLIC_SITE_URL=https://sharifmand.ir

# Google Search Console verification (در صورت تنظیم، meta tag اضافه می‌شه)
# مقدار رو از Google Search Console → Settings → Ownership verification بگیرید
NEXT_PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 Measurement ID (در صورت تنظیم، GA4 فعال می‌شه)
# مثال: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Bing Webmaster Tools verification (اختیاری)
NEXT_PUBLIC_BING_VERIFICATION=
