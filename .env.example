# دادبان (Dadban) — متغیرهای محیطی
# هیچ کلید واقعی‌ای در این فایل یا در کد ذخیره نمی‌شود.

# ─── دیتابیس (PostgreSQL) ──────────────────────────────────────────────
# خالی بگذارید تا در حالت degraded (بدون DB) اجرا شود
# برای Vercel: Neon/Supabase/Railway — مثال: postgresql://user:pass@host/db
DATABASE_URL=

# ─── احراز هویت کاربران (حداقل ۳۲ کاراکتر تصادفی) ─────────────────────
AUTH_SECRET=

# ─── مدیریت ادمین ───────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECRET=

# ─── هوش مصنوعی — زنجیره سوییچ خودکار چند-LLM ──────────────────────────
# ترتیب: ZAI-free (رایگان) → ATRIA → ZAI-pooli → LLM_KEYS_JSON → GEMINI → OPENROUTER → GROQ → SDK → بدون‌کلید
#
# 0) آتریا — پشتیبان اولِ همه چت‌ها (وقتی glm-flash محدود شد خودکار جواب می‌دهد):
#    پنل کلید: https://api.atria-asi.ai/console/keys
#    ⚠️ مدل Preview برای پاسخ‌های بلند کند است؛ اگر مدل سریع‌تری در پنل اضافه شد: ATRIA_MODEL=<model-id>
ATRIA_API_KEY=
ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_MODEL=Atria-Dawn-Preview
#
# 1) زنجیره کلیدهای مالک (همان فرمت homeino1) — وقتی سهمیه یکی تمام شد بعدی امتحان می‌شود:
# LLM_KEYS_JSON=[{"id":"glm","base":"https://api.z.ai/api/paas/v4","key":"...","model":"glm-4.7-flash","maxTokens":2400}]
#
# 2) کلید Z.ai (GLM) — مدل‌های glm-4.7-flash و glm-4.5-flash کلاً رایگان‌اند:
#    https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.7-flash
#
# 3) کلیدهای اختیاری دیگر (هرکدام فعال شوند به زنجیره اضافه می‌شوند):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.5-flash:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# 4) توکن endpoint تشخیص سلامت (/api/ai/llm-health با هدر x-health-token):
LLM_HEALTH_TOKEN=

# ─── دامنه ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dadban.ir

# ─── پیامک (کاوه‌نگار) — ورود با کد یکبارمصرف، بازیابی رمز، اطلاع‌رسانی ──
# پنل: https://panel.kavenegar.com — بدون کلید: dev کد را نمایش می‌دهد، پروداکشن ورود OTP را ۵۰۳ صادقانه می‌دهد
KAVEHNEGAR_API_KEY=
KAVEHNEGAR_SENDER=

# ─── ایمیل — رسید پرداخت، خوش‌آمد، بازیابی رمز (یکی کافی است) ───────────
# Resend (پیشنهادی، HTTP): https://resend.com/api-keys
RESEND_API_KEY=
# یا SMTP (هاست ایرانی/سرویس میل): smtps://user:pass@host:465
SMTP_URL=
EMAIL_FROM=دادبان <noreply@dadban.ir>

# ─── سئو و تحلیل (اختیاری) ─────────────────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BING_VERIFICATION=

# ─── ربات تلگرام — اطلاع‌رسانی زندهٔ پرونده (اختیاری) ──────────────────
# توکن از @BotFather؛ بدون توکن: کارت اتصال تلگرام «فعال نشده» صادقانه نشان می‌دهد
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT=

# ── پیامک فراز (Faraz SMS / IPPanel) ──
# کلید وب‌سرویس از پنل فراز (تنظیمات → API)
SMS_FARAZ_API_KEY=
# شمارهٔ خط فرستندهٔ پنل فراز — خط خدماتی (پیش‌فرض کد: 90008361؛ مناسب OTP/اطلاع‌رسانی)
SMS_FARAZ_SENDER=
# (اختیاری) هاست API فراز — پیش‌فرض https://api2.ippanel.com با فالبک https://api.ippanel.com
# SMS_FARAZ_API_BASE=
