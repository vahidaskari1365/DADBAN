# ═══════════════════════════════════════════════════════════════════════════
# نمونهٔ فایل متغیرهای محیطی تولید — /etc/dadvarzan/dadvarzan.env
# (setup-server.sh نسخهٔ واقعی را می‌سازد؛ این فایل فقط مرجعِ کلیدهاست)
# بعد از هر تغییر:  systemctl restart dadvarzan
# امنیت:            chmod 600 و فقط root
# ═══════════════════════════════════════════════════════════════════════════

# ── الزامی ──────────────────────────────────────────────────────────────────
# توسط setup-server.sh ساخته و پر می‌شود
DATABASE_URL=postgresql://dadvarzan:PASSWORD@127.0.0.1:5432/dadvarzan
# امضای سشن‌ها — تولید: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
# دامنهٔ نهایی سایت (برای متادیتا، sitemap، canonical و OG)
NEXT_PUBLIC_SITE_URL=https://your-domain.ir

# ── توکن‌های داخلی (تولید: openssl rand -hex 32) ────────────────────────────
CRON_SECRET=CHANGE_ME_openssl_rand_hex_32
# LAW_SYNC_TOKEN=
# I18N_WARM_KEY=
# LLM_HEALTH_TOKEN=

# ── پیامک (کاوه‌نگار) — برای OTP و نوتیفیکیشن ───────────────────────────────
# KAVEHNEGAR_API_KEY=
# KAVEHNEGAR_SENDER=

# ── ایمیل ──────────────────────────────────────────────────────────────────
# SMTP_URL=smtps://user:pass@smtp.example.ir:465
# EMAIL_FROM=دادورزان <no-reply@your-domain.ir>
# RESEND_API_KEY=

# ── پرداخت (زرین‌پال) ──────────────────────────────────────────────────────
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=false
# PAYMENT_PROVIDER=zarinpal
# PAYMENT_SANDBOX_ALLOW_PROD=false

# ── تلگرام (⚠ api.telegram.org از IP ایران معمولاً فیلتر است؛ بدون پروکسی
#     بخش تلگرام کار نمی‌کند — بقیهٔ سایت مستقل است) ─────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# NEXT_PUBLIC_TELEGRAM_BOT=

# ── هوش مصنوعی — حداقل یکی فعال باشد (زنجیره: Atria اول؛ Atria ایران است
#     و از IP ایران پاسخ می‌دهد؛ بقیه ممکن است فیلتر باشند) ─────────────────
# ATRIA_API_KEY=
# ATRIA_BASE_URL=
# ATRIA_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_VISION_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ZAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_KEYS_JSON=
# VISION_MODEL=

# ── سئو/آنالیتیکس — اگر در کلاینت inline لازم است، همان مقدار را در
#     GitHub → Settings → Secrets and variables → Actions → Variables هم بگذارید ─
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GSC_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=

# ── متفرقه ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
